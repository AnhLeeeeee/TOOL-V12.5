<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>ToolTikTokManagerV125</AssemblyName>
    <RootNamespace>ToolTikTokManagerV125</RootNamespace>
    <Product>Tool TikTok Manager V12.5</Product>
    <Version>12.5.0</Version>
    <FileVersion>12.5.0.0</FileVersion>
    <AssemblyVersion>12.5.0.0</AssemblyVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <OutputPath>..\dist_v125\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\ManagerShared\Models\*.cs" Link="Shared\Models\%(Filename)%(Extension)" />
    <Compile Include="..\ManagerShared\Services\*.cs" Link="Shared\Services\%(Filename)%(Extension)" />
    <Compile Include="..\ManagerShared\Utils\*.cs" Link="Shared\Utils\%(Filename)%(Extension)" />
    <Compile Include="..\ManagerShared\Controls\*.cs" Link="Shared\Controls\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ToolTikTokWorkerV125\ToolTikTokWorkerV125.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
