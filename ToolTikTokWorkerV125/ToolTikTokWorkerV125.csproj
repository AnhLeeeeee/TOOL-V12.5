<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>ToolTikTokWorkerV125</AssemblyName>
    <RootNamespace>ToolTikTokV11</RootNamespace>
    <Product>Tool TikTok V12.5 - V11.5 Worker</Product>
    <Version>12.5.0</Version>
    <FileVersion>12.5.0.0</FileVersion>
    <AssemblyVersion>12.5.0.0</AssemblyVersion>
    <ApplicationManifest>..\V115Core\app.manifest</ApplicationManifest>
    <OutputPath>..\dist_v125\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\V115Core\MainForm.cs" Link="V115Core\MainForm.cs" />
    <Compile Include="..\V115Core\Models\*.cs" Link="V115Core\Models\%(Filename)%(Extension)" />
    <Compile Include="..\V115Core\Services\*.cs" Link="V115Core\Services\%(Filename)%(Extension)" />
    <Compile Include="..\V115Core\Utils\*.cs" Link="V115Core\Utils\%(Filename)%(Extension)" />
    <Compile Include="..\ManagerShared\Services\ChromeProfileNameSyncService.cs" Link="Shared\ChromeProfileNameSyncService.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\defaults\**\*" Link="defaults\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
